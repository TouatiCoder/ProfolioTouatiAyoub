# ── Frontend ─────────────────────────────────────────────
# API URL — points to the Express server
VITE_API_URL=http://localhost:3001

# ── Database (MySQL) ─────────────────────────────────────
# Connection string format (commonly used by Prisma, Drizzle, etc.)
DATABASE_URL="mysql://root:@localhost:3306/forge_scale"

# Alternative: Individual connection variables
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="forge_scale"
