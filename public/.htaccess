<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forward API and Uploads requests to the Node.js backend (Port 3001)
  # IMPORTANT: If your Node.js app on Hostinger uses a different port, change 3001 below!
  RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]
  RewriteRule ^uploads/(.*)$ http://127.0.0.1:3001/uploads/$1 [P,L]

  # 2. React Router SPA fallback (redirects everything else to index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
