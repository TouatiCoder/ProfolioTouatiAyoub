{
  "compilerOptions": {
    "target": "ES2020",

    "module": "commonjs",

    "moduleResolution": "node",

    "lib": ["ES2020"],

    "outDir": "./dist",

    "rootDir": "./src",

    "strict": false,

    "noImplicitAny": false,

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "sourceMap": true,

    "types": ["node", "express"],

    "typeRoots": [
      "./node_modules/@types"
    ]
  },

  "include": [
    "src/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "prisma"
  ]
}