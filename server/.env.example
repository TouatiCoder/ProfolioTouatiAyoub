 # ── Database ─────────────────────────────────────────────────────────────────
# Hostinger example: mysql://user:password@host:3306/db_name
DATABASE_URL="mysql://user:password@localhost:3306/forge_scale_db"


# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a long random string for this — do not reuse the example below.
JWT_SECRET="generate_a_long_random_string_here_for_production"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS="https://touatiayoub.com,https://www.touatiayoub.com"

# ── Media storage (Cloudinary) ──────────────────────────────────────────────
# Required in production. Without these, uploads fall back to local disk, which
# Render (and most hosts) wipes on every deploy/restart — files disappear.
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Initial admin seed (optional — only used by `npm run prisma:seed`) ───────
# Required for the seed script to create/update an admin user; if unset, the
# seed script skips admin creation instead of falling back to a hardcoded
# default. Never commit real values here — this file is a tracked template.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
