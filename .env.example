# ==========================================
# BACKEND ENVIRONMENT VARIABLES (server/.env)
# ==========================================

# Database Configuration (MySQL)
# Hostinger Example: mysql://user:password@localhost:3306/db_name
DATABASE_URL="mysql://root:@localhost:3306/forge_scale_db"

# Server Configuration
PORT=3001
NODE_ENV="production"
ALLOWED_ORIGINS="https://touatiayoub.com,https://www.touatiayoub.com"

# Security
JWT_SECRET="generate_a_long_random_string_here_for_production"

# Media storage (Cloudinary) — required in production.
# Without these, uploaded images/videos fall back to local disk storage, which
# most hosts (including Render) wipe on every deploy/restart — uploads will
# disappear and 404 for visitors. Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (root/.env)
# ==========================================

# API URL (Leave empty if frontend and backend share the same domain and you use reverse proxy)
# VITE_API_URL="https://api.touatiayoub.com"
